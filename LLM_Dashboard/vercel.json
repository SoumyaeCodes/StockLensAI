{
  "builds": [
    {
      "src": "LLM_Dashboard/app.py",  // Corrected path to app.py
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "50mb",
        "runtime": "python3.11"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "LLM_Dashboard/app.py"  // Corrected path for routing
    }
  ],
  "functions": {
    "LLM_Dashboard/app.py": {    // Corrected path for function config
      "memory": 256,
      "maxDuration": 60,
      "includeFiles": [
        "LLM_Dashboard/**",       // Include the entire LLM_Dashboard directory
        "requirements.txt"       // Include requirements (if in root)
      ]
    }
  }
}