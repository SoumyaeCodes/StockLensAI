{
  "builds": [
    {
      "src": "app.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "50mb",
        "runtime": "python3.9"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "app.py"
    }
  ],
  "functions": {
    "app.py": {
      "memory": 256,
      "maxDuration": 60,
      "includeFiles": [
        "LLM_Dashboard/LSTM Model/**",  // Include everything in LSTM Model
        "app.py",                    // Explicitly include app.py
        "crew.py",                   // Explicitly include crew.py
        "lstm_model_predictor.py",    // Explicitly include this file
        "requirements.txt"          // Include requirements
      ]
    }
  }
}